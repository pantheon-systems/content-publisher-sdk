{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "PCC_SITE_ID",
    "PCC_TOKEN",
    "IS_CICD",
    "NPM_TOKEN"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ]
    },
    "deploy": {
      "dependsOn": [
        "build",
        "test",
        "lint"
      ]
    },
    "test": {
      "dependsOn": [
        "build",
        "^build"
      ],
      "inputs": [
        "src/**/*.tsx",
        "src/**/*.ts",
        "test/**/*.ts",
        "test/**/*.tsx"
      ]
    },
    "lint": {},
    "lint:fix": {
      "cache": false,
      "persistent": true
    },
    "dev": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "persistent": true,
      "outputs": [
        "!starters/vue-starter/**",
        "!starters/vue-starter-ts/**",
        "!packages/vue-sdk/**",
        "!local_testing/testpages/**"
      ]
    }
  }
}
